{
  "manifest_version": 3,
  "name": "YouTube Playlist Tagger",
  "version": "1.0",
  "description": "Adds custom tags to YouTube playlists for better organization.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}